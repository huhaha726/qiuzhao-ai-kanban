# 密钥模板：复制一份改名为 .env，把等号后面换成自己的值
# 本地运行读这个文件；部署到 Streamlit Cloud 后改用平台的 Secrets（键名完全一样）

# --- 火山方舟（豆包大模型）---
# 控制台：https://console.volcengine.com/ark  → API Key 管理
ARK_API_KEY=your_ark_api_key

# 模型名，或推理接入点 ID（形如 ep-2024xxxx）。
# 填自己在线推理里创建的那个接入点 ID 最稳妥。
ARK_MODEL=doubao-pro-32k

# --- 火山引擎 语音识别 ---
# 控制台：https://console.volcengine.com/speech  → 语音技术 → 应用管理
# VOLC_APP_ID 是应用 ID；VOLC_ACCESS_KEY 是该应用的 Access Token
VOLC_APP_ID=your_app_id
VOLC_ACCESS_KEY=your_access_token

# 一句话识别的集群名，一般不用改
VOLC_ASR_CLUSTER=volcengine_input_common
